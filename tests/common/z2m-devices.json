     "label": "Effect",
     "name": "effect",
     "property": "effect",
     "type": "enum",
     "values": [
      "blink",
      "breathe",
      "okay",
      "channel_change",
      "finish_effect",
      "stop_effect"
     ]
    },
    {
     "access": 3,
     "description": "Do not disturb mode, when enabled this function will keep the light OFF after a power outage",
     "label": "Do not disturb",
     "name": "do_not_disturb",
     "property": "do_not_disturb",
     "type": "binary",
     "value_off": false,
     "value_on": true
